{
  "id": "tc-35-review-single-pair-en-page",
  "description": "One pair: reviewing the portal EN page runs as gdsg@en without a language prompt.",
  "fixture": {
    "shape": "single"
  },
  "prompt": "/{plugin}:review-doc-style i18n/en/docusaurus-plugin-content-docs-portal/current/transactions/transactions.md",
  "options": {
    "maxTurns": 60,
    "permissionMode": "acceptEdits",
    "allowedTools": [
      "Bash(git:*)"
    ]
  },
  "assertions": [
    {
      "name": "profile gdsg@en",
      "type": "match",
      "path": "output",
      "pattern": "gdsg@en"
    },
    {
      "name": "no language prompt",
      "type": "no-match",
      "path": "output",
      "pattern": "(?i)(isn't|is not|not) (among|one of) the (project's )?declared|which language|proceed anyway"
    },
    {
      "type": "unchanged",
      "ignore": [
        ".doc-toolkit/"
      ]
    }
  ]
}
