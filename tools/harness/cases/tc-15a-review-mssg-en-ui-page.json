{
  "id": "tc-15a-review-mssg-en-ui-page",
  "description": "mssg-en review of an EN UI page: the profile is named and nothing is written; the findings are compared blind.",
  "fixture": {
    "shape": "single"
  },
  "prompt": "/{plugin}:review-doc-style i18n/en/docusaurus-plugin-content-docs-portal/current/transactions/transactions.md guide:mssg-en",
  "options": {
    "maxTurns": 60,
    "permissionMode": "acceptEdits",
    "allowedTools": [
      "Bash(git:*)"
    ]
  },
  "assertions": [
    {
      "name": "profile mssg-en@en",
      "type": "match",
      "path": "output",
      "pattern": "mssg-en@en"
    },
    {
      "type": "unchanged",
      "ignore": [
        ".doc-toolkit/"
      ]
    }
  ]
}
